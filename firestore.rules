rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Packages collection:
    // Anyone can read active packages (for the public catalog)
    // Only authenticated admins can write (create, update, delete, activate, deactivate)
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Conversations collection:
    // Only authenticated administrators can read/list/delete customer conversation logs
    // Creation/updates from live visitor chat sessions are allowed to log enquiries securely
    match /conversations/{conversationId} {
      allow read, delete: if request.auth != null;
      allow create, update: if true;
    }

    // Default fallback rule for other administrative collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
